# StrideWars Backend — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env — it is in .gitignore.
#
# The backend loads its .env from the backend/ directory root.
# These values must match what you configured in the root .env.example
# (which drives docker-compose.yml for the containerised services).

# ── PostgreSQL connection string (required) ────────────────────────────────
DATABASE_URL=postgresql://stridewars:changeme@localhost:5432/stridewars

# ── Redis (required) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend server ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Auth (Phase 3) ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
