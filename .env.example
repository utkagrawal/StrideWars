# StrideWars — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
#
# Apple Silicon / M-series note:
#   postgres:16 and redis:7 pull arm64 variants automatically from Docker Hub
#   when Docker Desktop is configured for Apple Silicon. No manual action needed,
#   but if you see "WARNING: The requested image's platform does not match the
#   detected host platform" it means your Docker is in x86 emulation mode —
#   reset Docker Desktop to Apple Silicon native to fix it.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=stridewars
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stridewars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Assembled connection string (used by backend/pg) ──────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://stridewars:changeme@localhost:5432/stridewars

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Backend server ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Auth (Phase 3) — set a real secret before using ───────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
