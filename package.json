{
  "name": "stridewars",
  "version": "1.0.0",
  "private": true,
  "description": "StrideWars monorepo root — competitive running & territory-capture platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "lint": "npm run lint --workspaces",
    "setup": "bash scripts/setup.sh",
    "start:prod": "docker compose -f docker-compose.prod.yml up -d",
    "infra:up": "bash scripts/infra-up.sh",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
